{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "YoutubeDownloader",
  "version": "2.0.0",
  "identifier": "dev.al8bright.youtubedownloader",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build"
  },
  "app": {
    "windows": [
      {
        "title": "YouTube Music Downloader",
        "width": 1120,
        "height": 840,
        "minWidth": 920,
        "minHeight": 640,
        "resizable": true,
        "backgroundColor": "#07050F",
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../../backend/dist/utube-backend/": "backend/"
    },
    "publisher": "al8bright",
    "shortDescription": "유튜브 음악을 MP3 · FLAC · MP4 로 받기",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "Korean",
          "English"
        ],
        "displayLanguageSelector": false
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
